# Configuración del entorno Flask
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Clave secreta de la aplicación (cambiar en producción)
SECRET_KEY=tu-clave-secreta-aqui

# Base de datos
# Para SQLite (por defecto):
# DATABASE_URL=sqlite:///instance/no_conformidades.db
# Para PostgreSQL en producción:
# DATABASE_URL=postgresql://usuario:password@localhost/no_conformidades

# Configuración de la aplicación
APP_NAME=Sistema de Gestión de No Conformidades
ITEMS_PER_PAGE=20
